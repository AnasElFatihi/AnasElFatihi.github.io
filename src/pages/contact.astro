---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact | Anas El Fatihi — Développeur SaaS"
  description="Contactez Anas El Fatihi pour discuter de votre projet SaaS, MVP ou automatisation IA. Réponse sous 24 heures."
>
  <Header />

  <main class="pt-24">
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

          <!-- Left: Info -->
          <div>
            <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-4">Contact</p>
            <h1 class="text-4xl font-bold text-slate-900 mb-6">
              Parlons de votre projet
            </h1>
            <p class="text-slate-600 text-lg leading-relaxed mb-10">
              Vous avez une idée de SaaS, un MVP à construire ou un workflow à automatiser ?
              Décrivez votre projet et je vous réponds sous 24 heures.
            </p>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="bg-blue-50 rounded-lg p-3 flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2">
                    <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-slate-900 mb-0.5">Email</div>
                  <a href="mailto:anaselfatihi1@gmail.com" class="text-slate-600 hover:text-blue-600 transition-colors text-sm">
                    anaselfatihi1@gmail.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="bg-blue-50 rounded-lg p-3 flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 6v6l4 2"/>
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-slate-900 mb-0.5">Disponibilité</div>
                  <div class="text-slate-600 text-sm">Réponse sous 24 heures</div>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="bg-blue-50 rounded-lg p-3 flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2">
                    <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <circle cx="12" cy="11" r="3"/>
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-slate-900 mb-0.5">Localisation</div>
                  <div class="text-slate-600 text-sm">Maroc · France · Remote worldwide</div>
                </div>
              </div>
            </div>

            <div class="mt-10 p-5 bg-slate-50 border border-slate-200 rounded-xl">
              <p class="text-sm text-slate-600 font-medium mb-1">Consultation initiale gratuite</p>
              <p class="text-sm text-slate-500">
                Premier échange de 30 min pour comprendre votre projet et évaluer si je peux vous aider.
              </p>
            </div>
          </div>

          <!-- Right: Form -->
          <div>
            <!-- Configure this form: create a free account at formspree.io and replace YOUR_FORM_ID -->
            <form
              id="contact-form"
              action="https://formspree.io/f/YOUR_FORM_ID"
              method="POST"
              class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm"
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-slate-700 mb-2">Nom *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Jean Dupont"
                    class="w-full border border-slate-300 rounded-lg px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-slate-700 mb-2">Email *</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="jean@startup.com"
                    class="w-full border border-slate-300 rounded-lg px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                  />
                </div>
              </div>

              <div class="mb-5">
                <label for="company" class="block text-sm font-medium text-slate-700 mb-2">Entreprise</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="Ma Startup SAS"
                  class="w-full border border-slate-300 rounded-lg px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                />
              </div>

              <div class="mb-7">
                <label for="project" class="block text-sm font-medium text-slate-700 mb-2">Description du projet *</label>
                <textarea
                  id="project"
                  name="message"
                  required
                  rows="5"
                  placeholder="Décrivez votre projet : contexte, objectifs, fonctionnalités souhaitées, délais..."
                  class="w-full border border-slate-300 rounded-lg px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors resize-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3.5 rounded-xl transition-colors flex items-center justify-center gap-2"
              >
                Envoyer ma demande
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>

              <p class="text-center text-xs text-slate-500 mt-4">
                Consultation initiale gratuite · Réponse sous 24h
              </p>
            </form>

            <!-- Success message (hidden by default) -->
            <div id="success-msg" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
              <svg class="mx-auto mb-4 text-green-600" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
              <h3 class="font-semibold text-slate-900 text-lg mb-2">Message envoyé !</h3>
              <p class="text-slate-600 text-sm">Je vous répondrai dans les 24 heures.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('success-msg');

  form?.addEventListener('submit', async (e) => {
    const action = form.getAttribute('action') ?? '';
    if (action.includes('YOUR_FORM_ID')) {
      e.preventDefault();
      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
      return;
    }

    e.preventDefault();
    const data = new FormData(form);

    try {
      const res = await fetch(action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      }
    } catch {
      // fallback: open mailto
      window.location.href = 'mailto:anaselfatihi1@gmail.com';
    }
  });
</script>
