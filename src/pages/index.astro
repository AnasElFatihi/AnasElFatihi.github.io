---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    title: 'Développement SaaS',
    description: "Création d'applications SaaS complètes, de l'architecture à la mise en production. Auth, facturation, dashboard admin et APIs robustes.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
  },
  {
    title: 'MVP & Validation',
    description: 'Développement rapide de MVPs pour tester vos hypothèses et valider votre marché. De l\'idée au produit en quelques semaines.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    title: 'Automatisation IA',
    description: "Intégration d'IA dans vos workflows pour automatiser les tâches répétitives et créer des expériences produit plus intelligentes.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>`,
  },
  {
    title: 'API & Backend',
    description: 'APIs RESTful scalables, intégrations tierces (Stripe, SendGrid) et architectures backend performantes prêtes pour la production.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>`,
  },
  {
    title: 'Consulting Technique',
    description: "Audit d'architecture, choix technologiques, code review et accompagnement stratégique pour vos équipes et projets.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0112 0v2"/></svg>`,
  },
];

const projects = [
  {
    title: 'FacturePro',
    category: 'SaaS B2B',
    description: 'Application de facturation SaaS pour PMEs avec gestion clients, devis automatisés et intégration paiements Stripe.',
    tech: ['Next.js', 'TypeScript', 'PostgreSQL', 'Stripe'],
    result: '+200 PMEs utilisatrices',
  },
  {
    title: 'FlowAI',
    category: 'Automatisation IA',
    description: "Plateforme d'automatisation qui connecte vos outils métier et applique l'IA pour réduire le traitement manuel.",
    tech: ['Python', 'FastAPI', 'OpenAI', 'React'],
    result: '80% de gain de temps',
  },
  {
    title: 'StockSync',
    category: 'Dashboard SaaS',
    description: 'Dashboard de gestion d\'inventaire en temps réel pour retaileurs multi-magasins avec alertes intelligentes.',
    tech: ['Astro', 'Supabase', 'TypeScript', 'Tailwind'],
    result: 'Déployé en 4 semaines',
  },
];

const techs = [
  'TypeScript', 'React', 'Next.js', 'Astro',
  'Node.js', 'Python', 'FastAPI',
  'PostgreSQL', 'Supabase', 'Redis',
  'Tailwind CSS', 'OpenAI', 'Stripe', 'Vercel',
];
---

<Layout>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative bg-[#0F172A] overflow-hidden">
      <div
        class="absolute inset-0 opacity-[0.15]"
        style="background-image: radial-gradient(circle, #475569 1px, transparent 1px); background-size: 32px 32px;"
      ></div>
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse 90% 60% at 50% 0%, rgba(59, 130, 246, 0.12) 0%, transparent 65%);"
      ></div>

      <div class="relative max-w-6xl mx-auto px-6 pt-32 pb-24 md:pt-40 md:pb-32">
        <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/20 rounded-full px-4 py-1.5 mb-8">
          <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
          <span class="text-blue-400 text-sm font-medium">Disponible pour nouveaux projets</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold text-white leading-[1.1] max-w-4xl mb-6">
          Je crée des SaaS performants qui
          <span class="text-blue-400"> transforment vos idées</span>
          {' '}en produits rentables.
        </h1>

        <p class="text-lg md:text-xl text-slate-400 max-w-2xl mb-10 leading-relaxed">
          Développement SaaS, MVP, automatisation IA et applications web modernes.
          De l'idée à la mise en production, rapidement et efficacement.
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            Discuter de votre projet
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="/projects"
            class="inline-flex items-center gap-2 border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            Voir mes réalisations
          </a>
        </div>

        <div class="mt-16 pt-8 border-t border-slate-800/60 flex flex-wrap gap-2.5">
          {techs.slice(0, 8).map(tech => (
            <span class="bg-slate-800/80 border border-slate-700/60 text-slate-400 text-xs font-medium px-3 py-1.5 rounded-full">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-6 py-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {[
            { value: '5+', label: "Ans d'expérience" },
            { value: '20+', label: 'Projets livrés' },
            { value: '15+', label: 'Technologies' },
            { value: '100%', label: 'Satisfaction client' },
          ].map(({ value, label }) => (
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-slate-900 mb-1">{value}</div>
              <div class="text-sm text-slate-500">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="bg-slate-50 py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">Services</p>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
            Ce que je construis
          </h2>
          <p class="text-slate-600 max-w-xl mx-auto">
            Des solutions techniques complètes pour transformer vos idées en produits qui génèrent de la valeur.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {services.map(({ title, description, icon }) => (
            <div class="bg-white border border-slate-200 rounded-xl p-6 hover:border-blue-300 hover:shadow-md transition-all group">
              <div class="text-blue-600 mb-4" set:html={icon} />
              <h3 class="font-semibold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">{title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{description}</p>
            </div>
          ))}
        </div>

        <div class="text-center mt-10">
          <a href="/services" class="inline-flex items-center gap-2 text-blue-600 font-medium hover:text-blue-500 transition-colors text-sm">
            Voir tous les services
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-14">
          <div>
            <p class="text-blue-600 text-sm font-semibold uppercase tracking-wider mb-3">Projets</p>
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900">
              Réalisations récentes
            </h2>
          </div>
          <a href="/projects" class="mt-4 md:mt-0 inline-flex items-center gap-2 text-slate-600 font-medium hover:text-slate-900 transition-colors text-sm">
            Voir tous les projets
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {projects.map(({ title, category, description, tech, result }) => (
            <div class="border border-slate-200 rounded-xl overflow-hidden hover:border-slate-300 hover:shadow-lg transition-all group flex flex-col">
              <div class="bg-gradient-to-br from-slate-800 to-slate-900 h-40 flex items-center justify-center">
                <span class="text-slate-600 text-sm font-medium tracking-wide">{title}</span>
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="text-xs text-blue-600 font-semibold uppercase tracking-wider mb-2">{category}</div>
                <h3 class="font-semibold text-slate-900 text-lg mb-2 group-hover:text-blue-600 transition-colors">{title}</h3>
                <p class="text-slate-600 text-sm mb-4 leading-relaxed flex-1">{description}</p>
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {tech.map(t => (
                    <span class="bg-slate-100 text-slate-600 text-xs px-2.5 py-1 rounded-md">{t}</span>
                  ))}
                </div>
                <div class="flex items-center gap-2 pt-4 border-t border-slate-100">
                  <span class="w-2 h-2 bg-green-500 rounded-full flex-shrink-0"></span>
                  <span class="text-sm font-medium text-slate-700">{result}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Technologies -->
    <section class="bg-[#0F172A] py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-blue-400 text-sm font-semibold uppercase tracking-wider mb-3">Stack Technique</p>
          <h2 class="text-2xl md:text-3xl font-bold text-white">Technologies maîtrisées</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          {techs.map(tech => (
            <span class="bg-slate-800 border border-slate-700 text-slate-300 text-sm font-medium px-4 py-2 rounded-full hover:border-blue-500/50 hover:text-white transition-colors cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-2xl p-12 md:p-16 text-center relative overflow-hidden">
          <div
            class="absolute inset-0 opacity-10"
            style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 28px 28px;"
          ></div>
          <div class="relative">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
              Prêt à lancer votre projet ?
            </h2>
            <p class="text-blue-100 text-lg mb-8 max-w-xl mx-auto">
              Décrivez votre idée et recevez une réponse sous 24 heures.
              Consultation initiale gratuite.
            </p>
            <a
              href="/contact"
              class="inline-flex items-center gap-2 bg-white text-blue-600 font-semibold px-8 py-4 rounded-xl hover:bg-blue-50 transition-colors text-lg shadow-lg"
            >
              Démarrer un projet
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
